<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <!-- Classroom sync with the class server (WebSocket + HTTP API). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets Edu Launcher (same signing key) list boards and open them. Declared by both apps. -->
    <permission
        android:name="id.kelasku.permission.BOARDS"
        android:label="Akses papan Papan Guru"
        android:protectionLevel="signature" />
    <uses-permission android:name="id.kelasku.permission.BOARDS" />

    <application
        android:label="${appLabel}"
        android:icon="${appIcon}"
        android:roundIcon="${appIcon}"
        android:banner="${appBanner}"
        android:usesCleartextTraffic="${cleartext}"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <provider
            android:name="id.kelasku.papanguru.CaptureProvider"
            android:authorities="${applicationId}.captures"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- Board list and thumbnails for Edu Launcher. -->
        <provider
            android:name="id.kelasku.papanguru.BoardsProvider"
            android:authorities="${applicationId}.boards"
            android:exported="true"
            android:readPermission="id.kelasku.permission.BOARDS"
            android:writePermission="id.kelasku.permission.BOARDS" />

        <activity
            android:name="id.kelasku.papanguru.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Edu Launcher's way in: new board, open board, import PDF, board list (BoardsContract). -->
        <activity-alias
            android:name="id.kelasku.papanguru.LauncherEntry"
            android:targetActivity="id.kelasku.papanguru.MainActivity"
            android:exported="true"
            android:permission="id.kelasku.permission.BOARDS" />
    </application>
</manifest>
